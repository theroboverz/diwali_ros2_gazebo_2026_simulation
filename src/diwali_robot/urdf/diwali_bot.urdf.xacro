<?xml version="1.0"?>
<!-- Differential-drive robot for Gazebo Harmonic (gz-sim 8).
     Uses gz-sim system plugins (NOT Gazebo Classic libgazebo_ros_* plugins). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diwali_bot">

  <xacro:property name="wheel_r" value="0.10"/>
  <xacro:property name="wheel_w" value="0.05"/>
  <xacro:property name="track"   value="0.40"/>   <!-- wheel separation -->
  <xacro:property name="body_x"  value="0.50"/>
  <xacro:property name="body_y"  value="0.34"/>
  <xacro:property name="body_z"  value="0.10"/>
  <xacro:property name="body_m"  value="8.0"/>
  <xacro:property name="wheel_m" value="0.8"/>

  <xacro:macro name="material_rgba" params="name r g b">
    <material name="${name}"><color rgba="${r} ${g} ${b} 1"/></material>
  </xacro:macro>
  <xacro:material_rgba name="saffron" r="0.95" g="0.5" b="0.1"/>
  <xacro:material_rgba name="charcoal" r="0.15" g="0.15" b="0.17"/>
  <xacro:material_rgba name="steel" r="0.6" g="0.62" b="0.65"/>

  <!-- ===== links ===== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="${body_x} ${body_y} ${body_z}"/></geometry>
      <material name="saffron"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="${body_x} ${body_y} ${body_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="${body_m}"/>
      <inertia ixx="${body_m*(body_y*body_y+body_z*body_z)/12}" ixy="0" ixz="0"
               iyy="${body_m*(body_x*body_x+body_z*body_z)/12}" iyz="0"
               izz="${body_m*(body_x*body_x+body_y*body_y)/12}"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="charcoal"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_m}"/>
        <inertia ixx="${wheel_m*(3*wheel_r*wheel_r+wheel_w*wheel_w)/12}" ixy="0" ixz="0"
                 iyy="${wheel_m*wheel_r*wheel_r/2}" iyz="0"
                 izz="${wheel_m*(3*wheel_r*wheel_r+wheel_w*wheel_w)/12}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel side="left"  y="${track/2}"/>
  <xacro:wheel side="right" y="${-track/2}"/>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_link">
      <visual><geometry><sphere radius="0.05"/></geometry><material name="steel"/></visual>
      <collision><geometry><sphere radius="0.05"/></geometry></collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} 0 -0.05"/>
    </joint>
    <!-- frictionless so the caster never fights the driven wheels -->
    <gazebo reference="${name}_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  </xacro:macro>
  <xacro:caster name="caster_front" x="0.2"/>
  <xacro:caster name="caster_rear"  x="-0.2"/>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.04" length="0.05"/></geometry><material name="charcoal"/></visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ===== joints ===== -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_r}"/>
  </joint>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.12 0 0.20"/>
  </joint>

  <!-- ===== Gazebo Harmonic systems ===== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <!-- wheel odometry stays inside Gazebo; odom -> base_footprint comes from the OdometryPublisher below -->
      <odom_topic>wheel_odom</odom_topic>
      <tf_topic>wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_velocity>0.8</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
    </plugin>
    <!-- Ground-truth odometry: the model's world pose, so odom == map (the map is drawn in world coordinates)
         and nav2.launch.py can publish map -> odom as identity instead of running AMCL on a street that
         repeats every 12 m. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- gpu_lidar is RENDERING-based: it sees every visual in its plane (not only collisions).
       The world keeps decorations out of the 0.30 m scan plane near the road. -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>
</robot>
